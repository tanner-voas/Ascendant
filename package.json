{
  "name": "ascendant",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 package.py",
    "test": "node --test tests/*.test.js",
    "serve": "python3 -m http.server 8765 --directory dist/standalone",
    "deploy:worker": "npx --yes wrangler@4 deploy",
    "test:headless": "node --test tests/headless.test.js tests/engagement.test.js tests/gui-engagement.test.js",
    "stress:movement": "node scripts/stress-movement-engagement.mjs",
    "stress:movement:deep": "node scripts/stress-movement-engagement.mjs --cases 200 --mixed"
  }
}
